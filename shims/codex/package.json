{
  "name": "@pocketagent/shim-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PocketAgent adapter shim driving the OpenAI Codex `codex app-server` (JSON-RPC over stdio) behind the unified HTTP protocol",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit",
    "smoke": "tsx smoke/smoke.ts"
  },
  "dependencies": {
    "@pocketagent/protocol": "file:../../packages/protocol",
    "fastify": "^5.2.1",
    "undici": "^8.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
