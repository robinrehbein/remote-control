<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Nur um zu erfahren, wann wieder ein Netz da ist (registerNetworkCallback). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Verbindung im Hintergrund halten (ConnectionService): ein
         Foreground-Service hält den Prozess und damit die WebSocket offen.
         specialUse statt dataSync, weil dataSync ab Android 15 auf 6 h
         gedeckelt ist — für eine über Nacht haltende Verbindung die falsche
         Kategorie. Sideload-Verteilung, kein Play-Review. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Systemdialog „Akku-Restriktionen umgehen“ aus den Einstellungen:
         ohne die Ausnahme trennt Doze die Verbindung über Nacht. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- In-App-Updater (Settings → App-Update): darf den System-Installer für
         ein heruntergeladenes Release-APK öffnen. Sideload-Verteilung ohne
         Store — der Nutzer muss "Unbekannte Apps installieren" einmalig für
         diese App erlauben. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".PocketAgentApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketAgent">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden|density"
            android:theme="@style/Theme.PocketAgent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pocketagent" android:host="session" />
            </intent-filter>
        </activity>

        <service
            android:name=".fcm.PocketFcmService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!--
          Hält die WebSocket-Verbindung zum Orchestrator offen, während die
          App im Hintergrund ist (stille Dauer-Notification mit
          Verbindungsstatus). specialUse mit deklariertem Subtyp: die
          dauerhafte Verbindung zu einem eigenen Server passt in keine der
          engeren Kategorien, und dataSync wäre ab Android 15 nach 6 h
          beendet.
        -->
        <service
            android:name=".connection.ConnectionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hält die WebSocket-Verbindung zum eigenen PocketAgent-Orchestrator offen, damit die App beim Wiederöffnen nicht neu verbinden muss." />
        </service>

        <!--
          Empfängt "Erlauben"/"Ablehnen" aus einer Approval-Notification
          (PocketFcmService.actionButton) — nur vom System adressiert (per
          PendingIntent), nie von einer anderen App, daher exported=false.
        -->
        <receiver
            android:name=".fcm.NotificationActionReceiver"
            android:exported="false" />

        <!--
          Nur ein Sicherheitsnetz: der eigene "sessions"-Kanal wird schon in
          PocketAgentApp.onCreate angelegt (bevor überhaupt eine Push kommen
          kann). Diese Meta-Daten steuern zusätzlich, was das FCM-SDK selbst
          verwendet, falls es je (z.B. durch einen künftigen reinen
          notification-Payload ohne data) an unserem onMessageReceived vorbei
          direkt rendert — sonst würde ohne sie der Fallback-Kanal
          "Miscellaneous" mit Default-Priorität und Launcher-Icon greifen.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="sessions" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!--
          Reicht dem System-Installer das in cacheDir/updates/ heruntergeladene
          Release-APK als content://-URI (UpdateInstaller). ${applicationId}
          statt fester Id, damit auch die usercatrust-Variante (eigene
          applicationId, siehe build.gradle.kts) eine eindeutige Authority hat.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
