# PocketAgent v2 environment (nach .env kopieren und ausfüllen)
# openssl rand -hex 32
MASTER_KEY=
SESSION_MEM_LIMIT=2g
IDLE_STOP_SEC=900
GC_DAYS=14

# ---- Das eine Runner-Image ------------------------------------------------
# Namensraum des Images, das jede Docker-Session fährt:
#   <RUNNER_IMAGE_PREFIX>/pi-runner:<RUNNER_IMAGE_TAG>
# Fehlt es auf dem Host, baut der Orchestrator es beim ersten Session-Start
# selbst über die Docker-API (kein Registry-Push nötig).
RUNNER_IMAGE_PREFIX=pocketagent
# Tag des Runner-Images. Nach Änderungen an runner/ hochzählen — nur dadurch
# merkt ensureRunnerImage, dass es neu bauen muss (Content-Hash-Tags wie in v1
# gibt es nicht mehr). Unset = latest.
RUNNER_IMAGE_TAG=latest
# Vollständig vorgegebenes Registry-Image, z. B. ghcr.io/acme/pi-runner:2026-08.
# GESETZT heißt: nur pullen, nie bauen. Leer lassen für den Selbstbau.
RUNNER_IMAGE=

# Optional per-session CPU limit in docker NanoCPUs (e.g. 1000000000 = 1 CPU).
# Empty/unset = unlimited.
SESSION_CPU_QUOTA=
# Optional: erlaubt entfernte Pairing-Code-Erzeugung via
#   POST /api/pairing/create (Authorization: Bearer <token>)
# und POST /api/secrets.
PAIRING_ADMIN_TOKEN=
# Optional: Firebase service account JSON as single line for FCM push
FCM_SERVICE_ACCOUNT_JSON=
# Auf 1 setzen, wenn ein Reverse-Proxy (Coolify/Traefik) davor steht, damit
# req.ip den echten Client aus X-Forwarded-For auflöst — sonst teilen sich alle
# Clients die Proxy-Adresse (WS-Verbindungslimit, Pairing-Rate-Limit). NIEMALS
# setzen, wenn der Server direkt exponiert ist: X-Forwarded-For ist dann vom
# Angreifer wählbar.
TRUST_PROXY=

# ---- Fly.io-Sessions (Produktion) ---------------------------------------
# Eine Machine je Session auf Fly.io: disk-less, klont das Repo beim Start,
# meldet sich per outbound WSS (frischer Link-Token je Session). Fly ist
# aktiviert, sobald FLY_API_TOKEN steht — Details: RUNBOOK-PI.md, Abschnitt
# „Fly-Sessions“.
# Pflicht für Fly: Token unter fly.io -> Settings -> API erzeugen.
FLY_API_TOKEN=
# Fly-App, unter der der Server die Session-Machines verwaltet (einmalige
# Anlage: automatisch mit FLY_ORG_SLUG beim ersten Start, oder manuell
#   fly apps create --name <FLY_APP_NAME> --org <org>).
FLY_APP_NAME=pocketagent-sessions
# Nur nötig, solange die App noch nicht existiert: erlaubt dem Server, sie
# einmalig anzulegen. Danach kann die Variable wieder weg.
FLY_ORG_SLUG=
# Optional: Region der Machines (z. B. fra). Leer = Fly wählt.
FLY_REGION=
# Optional: voller Image-Ref der Machine (z. B. ghcr.io/acme/fly-link:2026-08).
# GESETZT heißt: nie bauen, nie pushen — die Machine startet von genau diesem
# Ref (z. B. vom öffentlichen ghcr-Image, ganz ohne Registry-Auth).
FLY_IMAGE=
# Deckel für gleichzeitig laufende Fly-Machines (creating/running/idle); die
# nächste session.create wird abgewiesen. Ungültige Werte fallen auf 3 zurück.
FLY_MAX_MACHINES=3

# Push-Ziel des Fly-Link-Images (z. B. ghcr.io/<owner>/fly-link:2026-08).
# Ohne FLY_IMAGE Pflicht: der Server baut dann <RUNNER_IMAGE_PREFIX>/fly-link:
# <RUNNER_IMAGE_TAG> beim ersten Session-Start und pusht es hierher.
GHCR_IMAGE=
# GitHub-PAT mit write:packages für den Image-Push, plus zugehöriger Username.
GHCR_PUSH_TOKEN=
GHCR_USERNAME=

# Öffentliche Basis-URL des Orchestrators (Pflicht für Fly), z. B.
# https://pa.example.com — PA_SERVER der Machine wird daraus abgeleitet
# (https -> wss, http -> ws).
PUBLIC_URL=
# Öffentliche URL des Egress-Proxys OHNE Userinfo (Pflicht für Fly-Sessions
# mit Policy 'allowlist'). TLS empfohlen: ohne trägt das Proxy-Token im
# Klartext. z. B. https://egress.example.com oder http://egress.example.com:3128
EGRESS_PUBLIC_URL=
# Hinweis: RUNNER_IMAGE_TAG gilt auch für das Fly-Image — neuer Tag heißt
# neuer Build und neuer Push (Tag in GHCR_IMAGE entsprechend mitziehen).
