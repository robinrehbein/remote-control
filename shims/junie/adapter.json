{
  "$schema": "https://pocketagent.dev/schemas/adapter.json",
  "id": "junie",
  "name": "Junie",
  "description": "JetBrains Junie CLI headless one-shot; Junie API key or BYOK. No remote approvals (app shows banner).",
  "capabilities": { "approvals": false, "resume": false, "streaming": false, "autoPush": true, "reasoning": false, "modelSwitch": true },
  "credentials": {
    "junie": ["JUNIE_API_KEY"]
  },
  "providerEnv": {
    "openai": "OPENAI_API_KEY",
    "anthropic": "ANTHROPIC_API_KEY",
    "google": "GOOGLE_API_KEY",
    "xai": "XAI_API_KEY",
    "openrouter": "OPENROUTER_API_KEY"
  },
  "providers": [
    { "id": "junie", "name": "JetBrains Junie", "hint": "Junie-API-Key aus dem JetBrains-Account (usage-based); alternativ eigenen Provider-Key hinterlegen" },
    { "id": "openai", "name": "OpenAI", "keyUrl": "https://platform.openai.com/api-keys", "hint": "API-Key von platform.openai.com (sk-…)" },
    { "id": "anthropic", "name": "Anthropic", "keyUrl": "https://console.anthropic.com/settings/keys", "hint": "API-Key von console.anthropic.com (sk-ant-…)" },
    { "id": "google", "name": "Google Gemini", "keyUrl": "https://aistudio.google.com/apikey", "hint": "API-Key aus Google AI Studio" },
    { "id": "xai", "name": "xAI", "keyUrl": "https://console.x.ai", "hint": "API-Key von console.x.ai" },
    { "id": "openrouter", "name": "OpenRouter", "keyUrl": "https://openrouter.ai/settings/keys", "hint": "API-Key von openrouter.ai (sk-or-…)" }
  ],
  "defaults": { "provider": "openai", "model": "" }
}
