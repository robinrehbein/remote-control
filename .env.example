# PocketAgent environment (copy to .env and fill in)
# openssl rand -hex 32
MASTER_KEY=
SESSION_MEM_LIMIT=2g
IDLE_STOP_SEC=900
GC_DAYS=14
# Image prefix for adapter shims. Missing images are built automatically by the
# orchestrator from its bundled sources (self-build) under this prefix; a
# registry prefix (ghcr.io/<owner>) also works without a registry - images are
# then built locally under that name and only pulled when they exist remotely.
ADAPTER_IMAGE_PREFIX=pocketagent
# Tag pin for adapter shim images. LEAVE UNSET for the default content-hash tags
# (auto-rebuild whenever shim sources change on deploy). Set a fixed tag only to
# pin reproducible deploys - the self-build then never refreshes it automatically.
# Per-adapter digest pins go into shims/<id>/adapter.json "image" instead.
# ADAPTER_IMAGE_TAG=
# Optional per-session CPU limit in docker NanoCPUs (e.g. 1000000000 = 1 CPU).
# Empty/unset = unlimited.
SESSION_CPU_QUOTA=
# Remote-docker mode (DOCKER_HOST=tcp://...) only: EXPLICIT CONSENT that remote
# sessions may run with networkPolicy 'open' - shim traffic is plaintext HTTP
# over DOCKER_ADDR (published ports) unless you tunnel (SSH/WireGuard, FLY.md).
# Leave empty to refuse remote sessions; 'allowlist'/'isolated' always require
# the local docker socket.
REMOTE_NETWORK_OPEN=
# Remote-docker mode only: host IP shim ports are published on. Default
# 127.0.0.1 keeps them off the LAN - reach them from the orchestrator via SSH
# reverse tunnel, or set to a WireGuard interface IP.
DOCKER_PUBLISH_IP=127.0.0.1
# Optional: allows remote pairing-code creation via
#   POST /api/pairing/create (Authorization: Bearer <token>)
# also used by POST /api/secrets, i.e. the pocketagent-secret CLI (see cli/)
PAIRING_ADMIN_TOKEN=
# Optional: Firebase service account JSON as single line for FCM push
FCM_SERVICE_ACCOUNT_JSON=
