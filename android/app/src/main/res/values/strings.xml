<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">PocketAgent</string>
    <!-- Der genaue Befehl hängt vom Server-Setup ab (Docker, systemd, npm, …) —
         darum bewusst generisch statt eines Kommandos, das nicht überall gilt. -->
    <string name="pairing_hint_code">Den Pairing-Code erzeugst du auf dem Server – der genaue Befehl steht in der Doku deiner Installation.</string>
    <string name="pairing_server_url">Server-URL</string>
    <string name="pairing_code">Pairing-Code</string>
    <string name="pairing_device_name">Gerätename</string>
    <string name="pairing_button">Koppeln</string>
    <string name="notification_channel_sessions">Sessions</string>
    <!-- Aktionsbuttons einer Approval-Notification — dieselben Begriffe wie
         auf der Approval-Karte im SessionScreen (dort primär "Erlauben",
         sekundär "Ablehnen"). -->
    <string name="notification_action_allow">Erlauben</string>
    <string name="notification_action_deny">Ablehnen</string>
    <!-- Zwischenstand, solange die Antwort noch unterwegs ist (WS-Verbindung
         wird ggf. erst aufgebaut, s. AppRepository.respondToPermission). -->
    <string name="notification_decision_pending">Wird gesendet …</string>
    <string name="notification_decision_allowed">Erlaubt</string>
    <string name="notification_decision_denied">Abgelehnt</string>
    <!-- Kein Netz/Server in der Zeit erreichbar, in der ein Notification-Tap
         ohne App-Start beantwortet werden kann — zum Öffnen auffordern statt
         die Antwort stillschweigend zu verlieren. -->
    <string name="notification_decision_failed">Nicht zugestellt – zum Öffnen tippen</string>
    <string name="notification_group_summary">Neue Ereignisse in dieser Session</string>
    <!-- Stiller Dauer-Kanal des ConnectionService: hält die WebSocket im
         Hintergrund offen, damit die App beim Öffnen nicht neu verbinden
         muss (Einstellungen → Server → „Im Hintergrund verbunden bleiben“). -->
    <string name="connection_channel_name">Verbindung im Hintergrund</string>
    <string name="connection_notification_title">PocketAgent bleibt verbunden</string>
    <string name="connection_notification_connecting">Verbindung wird aufgebaut …</string>
</resources>
